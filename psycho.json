          "pl-vless-grpc-4",
          "se-vless",
          "ch-vless-grpc"
        ],
        "strategy": {
          "type": "leastLoad",
          "settings": {
            "expected": 3,
            "baselines": ["120ms", "250ms", "500ms"]
          }
        },
        "fallbackTag": "de-vless"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "socks",
      "port": 10808,
      "listen": "127.0.0.1",
